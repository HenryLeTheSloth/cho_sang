DATABASE_URL=postgresql://chosang:chosang@localhost:5432/chosang
UPLOAD_DIR=uploads
# Ký cookie giỏ hàng/phiên. Production: openssl rand -hex 32 (giá trị dev-only bị từ chối)
SESSION_SECRET=dev-only-doi-chuoi-nay-khi-deploy
# INSECURE_COOKIES=1  # chỉ khi demo bản build production qua http:// trong LAN (trình duyệt không lưu cookie Secure từ http)
# Đăng nhập khách bằng OTP giả lập: mã hiện trên màn hình kèm nhãn DEMO, không gửi SMS. Không đặt = tắt (fail-closed)
DEMO_OTP=1
# Mã quản trị cho SĐT admin (seed: 0909000000). Không đặt = admin không đăng nhập được. Production: ≥12 ký tự, không dùng giá trị dev-only
ADMIN_PASSCODE=dev-only-ma-quan-tri
