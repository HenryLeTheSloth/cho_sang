generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  admin
}

enum PaymentMethod {
  cod
  online_mock
}

enum PaymentStatus {
  unpaid
  paid
  failed
}

enum OrderStatus {
  pending
  preparing
  shipping
  done
  cancelled
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?
  email     String?
  role      Role     @default(customer)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  image    String
  sort     Int       @default(0)
  products Product[]
}

model Product {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  name         String
  nameSearch   String
  description  String
  categoryId   Int
  category     Category     @relation(fields: [categoryId], references: [id])
  priceVnd     Int
  compareAtVnd Int?
  unit         String
  netGrams     Int?
  isWeighed    Boolean      @default(false)
  origin       String
  shelfLife    String
  storage      String
  stock        Int          @default(0)
  images       String[]
  cutoutUrl    String?
  isGiftBase   Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  orderItems   OrderItem[]
  giftBundles  GiftBundle[]

  @@index([categoryId])
}

model Order {
  id               Int           @id @default(autoincrement())
  code             String        @unique
  checkoutKey      String?       @unique // khoá chống đặt trùng: một lần mở trang checkout = tối đa một đơn
  userId           Int?
  user             User?         @relation(fields: [userId], references: [id])
  customerName     String
  phone            String
  address          String
  note             String        @default("")
  callOnSubstitute Boolean       @default(false)
  deliveryDate     DateTime      @db.Date
  deliverySlot     String
  subtotalVnd      Int
  shippingVnd      Int
  totalVnd         Int
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(unpaid)
  status           OrderStatus   @default(pending)
  createdAt        DateTime      @default(now())
  preparingAt      DateTime?
  shippingAt       DateTime?
  doneAt           DateTime?
  cancelledAt      DateTime?
  items            OrderItem[]

  @@index([phone])
  @@index([userId])
}

model OrderItem {
  id               Int         @id @default(autoincrement())
  orderId          Int
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product     @relation(fields: [productId], references: [id])
  bundleId         String?
  bundle           GiftBundle? @relation(fields: [bundleId], references: [id])
  nameSnapshot     String
  unitSnapshot     String
  priceSnapshotVnd Int
  qty              Int

  @@index([orderId])
}

model GiftBundle {
  id            String      @id @default(cuid())
  baseProductId Int
  baseProduct   Product     @relation(fields: [baseProductId], references: [id])
  layout        Json
  message       String      @default("")
  preview       String
  createdAt     DateTime    @default(now())
  orderItems    OrderItem[]
}
